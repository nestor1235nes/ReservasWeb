# ==========================================================================
#  PLANTILLA DE VARIABLES DE ENTORNO — Backend Reservas
#
#  Copia este archivo como ".env" y completa los valores para desarrollo local:
#      cp .env.template .env
#
#  En producción (Cloud Run) define estas variables en la configuración del
#  servicio, NO en un archivo .env.
#
#  Convención:  (SECRETO) = no compartir / rotar si se filtra
#               (público)  = puede exponerse en el navegador
# ==========================================================================

# --- Núcleo / Infraestructura ---
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/mern-tasks
TOKEN_SECRET=                       # (SECRETO) cadena larga y aleatoria; NO uses "secret"

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,https://agendavitalink.vercel.app,https://agendavitalink.cl,https://www.agendavitalink.cl
FRONTEND_BASE_URL=http://localhost:5173
REACT_APP_API_URL=http://localhost:4000

# --- Google OAuth ---
CLIENT_ID=                          # (público) Google OAuth Client ID

# --- Daily.co (telemedicina) ---
DAILY_API_KEY=                      # (SECRETO) API key de Daily.co

# --- WhatsApp (Green-API) ---
GREENAPI_ID_INSTANCE=               # (también se acepta WHATSAPP_ID_INSTANCE)
GREENAPI_API_TOKEN_INSTANCE=        # (SECRETO) (también WHATSAPP_API_TOKEN_INSTANCE)

# --- Email (Brevo) ---
BREVO_SMTP_HOST=
BREVO_SMTP_PORT=
BREVO_SMTP_USER=
BREVO_SMTP_PASS=                    # (SECRETO)
FROM_EMAIL=
FROM_NAME=
BREVO_ENFORCE_DOMAIN=               # opcional
BREVO_VERIFIED_DOMAIN=              # opcional
USE_BREVO_API=                      # "true" para usar la API HTTP en vez de SMTP
BREVO_API_KEY=                      # (SECRETO) requerido si USE_BREVO_API=true

# --- Pagos (Transbank Webpay) ---
# Por defecto se usa el ambiente de INTEGRACIÓN (pruebas). Para cobrar de verdad,
# poner WEBPAY_ENVIRONMENT=production y definir las credenciales REALES de Transbank.
WEBPAY_ENVIRONMENT=                 # vacío o "integration" (pruebas) | "production" (real)
WEBPAY_COMMERCE_CODE=               # código de comercio (requerido en production)
WEBPAY_API_KEY=                     # (SECRETO) llave de producción (requerido en production)

# --- Google Cloud Storage ---
GCS_PRIVATE_IMAGES_BUCKET=          # bucket de imágenes privadas (fichas)
GCS_PUBLIC_ASSETS_BUCKET=           # bucket de assets públicos (logos, etc.)

# --- OTP de pacientes (valores con defaults razonables) ---
PATIENT_OTP_TTL_MINUTES=10
PATIENT_OTP_MAX_ATTEMPTS=5
PATIENT_OTP_SECRET=                 # (SECRETO) recomendado en producción
PATIENT_OTP_BRAND=
PATIENT_TOKEN_EXPIRES_IN=12h

# --- OTP de reseteo de contraseña ---
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_OTP_SECRET=          # (SECRETO) recomendado en producción
PASSWORD_RESET_OTP_BRAND=

# --- Administradores de plataforma (acceso a /api/admin) ---
PLATFORM_ADMIN_USER_ID=             # opcional: id de usuario admin
PLATFORM_ADMIN_EMAILS=              # opcional: lista separada por comas
