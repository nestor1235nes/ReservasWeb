# ==========================================================================
#  PLANTILLA DE VARIABLES DE ENTORNO — Frontend (Vite/React)
#
#  Copia este archivo como ".env" y completa los valores que necesites:
#      cp .env.example .env
#
#  En Vite, SOLO las variables con prefijo VITE_ se exponen al navegador.
#  Por diseño, TODAS estas variables son visibles en el cliente: usa aquí
#  únicamente identificadores/llaves públicas o restringidas por dominio.
#
#  En producción (Vercel) define estas variables en la configuración del proyecto.
# ==========================================================================

# URL base del API. Si se omite, el cliente la deduce del origen
# (localhost:4000/api en desarrollo, mismo origen + /api en producción).
VITE_API_URL=

# Google OAuth Client ID (público). Usado para login con Google y Calendar.
VITE_GOOGLE_CLIENT_ID=

# Google API Key (restríngela por dominio en Google Cloud Console).
# Usada por Google Calendar y el autocompletado de direcciones (Maps).
VITE_GOOGLE_API_KEY=

# Token público de Mapbox (pk.*). Se acepta cualquiera de los dos nombres.
VITE_MAPBOX_ACCESS_TOKEN=
VITE_MAPBOX_TOKEN=
