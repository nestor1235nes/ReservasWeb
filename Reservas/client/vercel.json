{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://reservas-backend-738093538653.southamerica-east1.run.app/api/$1" },
    { "source": "/uploads/(.*)", "destination": "https://reservas-backend-738093538653.southamerica-east1.run.app/uploads/$1" },
    { "source": "/imagenesPacientes/(.*)", "destination": "https://reservas-backend-738093538653.southamerica-east1.run.app/imagenesPacientes/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist"
}